<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Manage Appointments | MediCare Plus Admin</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="../css/main.css" />
</head>
<body class="dashboard-body" data-dashboard data-role="admin" data-page="appointments" data-base-path="../">

  <div class="dashboard-layout role-admin" data-role="admin">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
        <span class="sidebar-brand-text">Medi<span>Care</span> Plus</span>
      </div>
      <div class="sidebar-user">
        <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="Admin avatar" />
        <div class="sidebar-user-info">
          <h5 data-current-user-name>System Admin</h5>
          <span data-current-user-role>ADMIN</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <span class="nav-section-label">Overview</span>
        <a href="dashboard.html" class="nav-item"><i class="fa-solid fa-gauge-high"></i><span class="nav-label">Dashboard</span></a>

        <span class="nav-section-label">Hospital Management</span>
        <a href="doctors.html" class="nav-item"><i class="fa-solid fa-user-doctor"></i><span class="nav-label">Doctors</span></a>
        <a href="patients.html" class="nav-item"><i class="fa-solid fa-hospital-user"></i><span class="nav-label">Patients</span></a>
        <a href="appointments.html" class="nav-item active"><i class="fa-solid fa-calendar-check"></i><span class="nav-label">Appointments</span></a>
        <a href="departments.html" class="nav-item"><i class="fa-solid fa-sitemap"></i><span class="nav-label">Departments</span></a>
        <a href="treatments.html" class="nav-item"><i class="fa-solid fa-stethoscope"></i><span class="nav-label">Treatments</span></a>
        <a href="medicines.html" class="nav-item"><i class="fa-solid fa-pills"></i><span class="nav-label">Medicines</span></a>

        <span class="nav-section-label">Insights</span>
        <a href="reports.html" class="nav-item"><i class="fa-solid fa-chart-line"></i><span class="nav-label">Reports</span></a>
        <a href="settings.html" class="nav-item"><i class="fa-solid fa-gear"></i><span class="nav-label">Settings</span></a>
        <a href="../index.html" class="nav-item"><i class="fa-solid fa-arrow-left"></i><span class="nav-label">Back to Site</span></a>
      </nav>
      <div class="sidebar-footer">
        <a href="login.html" class="nav-item logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i><span class="nav-label">Logout</span></a>
      </div>
    </aside>
    <div class="sidebar-overlay"></div>

    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Appointments</h1>
            <p>All patient bookings across every department</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="appointments-search" placeholder="Search by patient or doctor…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="login.html" class="danger logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="stat-cards" style="margin-bottom:1.75rem;">
          <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-calendar-days"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total</div>
              <div class="stat-card-value" id="appt-stat-total">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon orange"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Pending</div>
              <div class="stat-card-value" id="appt-stat-pending">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon green"><i class="fa-solid fa-circle-check"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Approved</div>
              <div class="stat-card-value" id="appt-stat-approved">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon purple"><i class="fa-solid fa-flag-checkered"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Completed</div>
              <div class="stat-card-value" id="appt-stat-completed">0</div>
            </div>
          </div>
        </div>

        <div class="page-toolbar">
          <h2>All Appointments <span class="badge badge-primary" id="appointments-count">0 of 0</span></h2>
          <div class="page-toolbar-actions">
            <select id="appointments-status-filter" class="form-control" style="max-width:180px;">
              <option value="all">All Status</option>
              <option value="pending">Pending</option>
              <option value="approved">Approved</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
            </select>
            <input type="date" id="appointments-date-filter" class="form-control" style="max-width:170px;" />
            <button type="button" class="btn btn-outline" data-export-csv="#appointments-table" data-filename="appointments.csv">
              <i class="fa-solid fa-file-arrow-down"></i> Export CSV
            </button>
            <button type="button" class="btn btn-primary" id="add-appointment-btn">
              <i class="fa-solid fa-plus"></i> New Appointment
            </button>
          </div>
        </div>

        <div class="table-wrapper">
          <table class="table" id="appointments-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Department</th>
                <th>Date &amp; Time</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="appointments-tbody"></tbody>
          </table>
        </div>
        <div class="pagination" id="appointments-pagination"></div>
      </main>
    </div>
  </div>

  <!-- Add Appointment Modal -->
  <div class="modal-backdrop" id="appointment-modal-backdrop"></div>
  <div class="modal modal-lg" id="appointment-modal" role="dialog" aria-modal="true" aria-labelledby="appointment-modal-title">
    <div class="modal-header">
      <h3 id="appointment-modal-title">Book New Appointment</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form id="appointment-form">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="appt-patient">Existing Patient</label>
          <select id="appt-patient" name="patientId" class="form-control"></select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="appt-patient-name">Patient Name <span class="required">*</span></label>
            <input type="text" id="appt-patient-name" name="patientName" class="form-control" placeholder="Full name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="appt-patient-phone">Patient Phone</label>
            <input type="tel" id="appt-patient-phone" name="patientPhone" class="form-control" placeholder="+1 555-0100" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="appt-patient-email">Patient Email</label>
          <input type="email" id="appt-patient-email" name="patientEmail" class="form-control" placeholder="patient@example.com" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="appt-department">Department <span class="required">*</span></label>
            <select id="appt-department" name="departmentId" class="form-control" required></select>
          </div>
          <div class="form-group">
            <label class="form-label" for="appt-doctor">Doctor <span class="required">*</span></label>
            <select id="appt-doctor" name="doctorId" class="form-control" required></select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="appt-date">Date <span class="required">*</span></label>
            <input type="date" id="appt-date" name="date" class="form-control" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="appt-time">Time <span class="required">*</span></label>
            <select id="appt-time" name="time" class="form-control" required></select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="appt-reason">Reason for Visit</label>
          <textarea id="appt-reason" name="reason" class="form-control" rows="3" placeholder="Reason for visit / symptoms…"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> Book Appointment</button>
      </div>
    </form>
  </div>

  <!-- View Appointment Modal -->
  <div class="modal-backdrop" id="appointment-view-modal-backdrop"></div>
  <div class="modal" id="appointment-view-modal" role="dialog" aria-modal="true" aria-labelledby="appointment-view-title">
    <div class="modal-header">
      <h3 id="appointment-view-title">Appointment Details</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body" id="appointment-view-body"></div>
    <div class="modal-footer" id="appointment-view-footer"></div>
  </div>

  <div class="toast-container"></div>

  <script src="../js/data.js"></script>
  <script src="../js/auth.js"></script>
  <script src="../js/components.js"></script>
  <script src="../js/appointment.js"></script>
  <script src="../js/dashboard.js"></script>
  <script src="../js/admin.js"></script>
  <script src="../js/main.js"></script>
  <script>
    MediCareAuth.requireAuth('admin', 'login.html');
    MediCareAdmin.initShell();
    MediCareAdmin.initAppointmentsPage();
  </script>
</body>
</html>
