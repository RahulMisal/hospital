<%- include('header.ejs'); %>

      <div class="dashboard-content">

        <div class="profile-layout">
          <div class="profile-sidebar-card">
            <div class="profile-avatar-wrap">
              <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=200&q=80" alt="<%=data.p_name %>" />
              <span class="avatar-edit" title="Change photo"><i class="fa-solid fa-camera"></i></span>
            </div>
            <h3><%=data.p_name %></h3>
            <span class="role-tag">Patient Account</span>
            <p class="text-muted" style="font-size:0.875rem; margin-bottom:0;"><%=data.p_email%></p>
            <div class="profile-stats-mini">
              <div>
                <strong>12</strong>
                <span>Appointments</span>
              </div>
              <div>
                <strong>2022</strong>
                <span>Member Since</span>
              </div>
            </div>
          </div>

          <div class="profile-form-card">
            <div class="profile-form-tabs" data-tabs>
              <button type="button" class="active" data-tab="info">Personal Information</button>
              <button type="button" data-tab="security">Security</button>
            </div>

            <div class="profile-form-body">
              <div class="tab-panel active" data-tab-panel="info">
                <div class="form-section-title">Personal Information</div>
                <form action="/customer/profile_save" method="post" enctype="multipart/form-data">
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Photo <span class="required">*</span></label>
                      <input type="file" name="p_photo" class="form-control" required />
                      <input type="hidden" name="p_photo_old" class="form-control" value="<%=data.p_name %>" required />
                    </div>
                    <div class="form-group">
                      <label class="form-label">Full Name <span class="required">*</span></label>
                      <input type="text" name="p_name" class="form-control" value="<%=data.p_name %>" required />
                    </div>
                    <div class="form-group">
                      <label class="form-label">Email Address</label>
                      <input type="email" name="p_email" class="form-control" value="<%=data.p_email%>"  />
                      <p class="form-hint">Contact support to change your registered email.</p>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Phone Number</label>
                      <input type="tel" name="p_phone" class="form-control" value="<%=data.p_phone%>" placeholder="+1 555-0100" />
                    </div>
                    <% if(data){ %>
                    <div class="form-group">
                      <label class="form-label">Date of Birth</label>
                      <!-- <%=data.p_dob%> -->
                      <input type="date" name="p_dob" class="form-control" value="<%=data.p_dob%>" value="1994-03-12" />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Blood Group</label>
                      <select name="p_bloodgroup" class="form-control">
                        <option value="">Select</option>
                        <option <% if(data.p_bloodgroup == "A+"){ %> selected <% } %>>A+</option>
                        <option <% if(data.p_bloodgroup == "A-"){ %> selected <% } %>>A-</option>
                        <option <% if(data.p_bloodgroup == "B+"){ %> selected <% } %>>B+</option>
                        <option <% if(data.p_bloodgroup == "B-"){ %> selected <% } %>>B-</option>
                        <option <% if(data.p_bloodgroup == "AB+"){ %> selected <% } %>>AB+</option>
                        <option <% if(data.p_bloodgroup == "AB-"){ %> selected <% } %>>AB-</option>
                        <option <% if(data.p_bloodgroup == "O+"){ %> selected <% } %>>O+</option>
                        <option <% if(data.p_bloodgroup == "O-"){ %> selected <% } %>>O-</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Gender</label>
                      <select name="p_gender" class="form-control">
                        <option value="">Select</option>
                        <option <% if(data.p_gender == "female"){ %> selected <% } %> value="female">Female</option>
                        <option <% if(data.p_gender == "male"){ %> selected <% } %> value="male">Male</option>
                        <option <% if(data.p_gender == "other"){ %> selected <% } %> value="other">Other</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Address</label>
                    <textarea name="p_address" class="form-control" rows="3" placeholder="Street, city, state, ZIP"><%=data.p_address%></textarea>
                  </div>
                   <% }else { %>
                       <div class="form-group">
                      <label class="form-label">Date of Birth</label>
                      <input type="date" name="p_dob" class="form-control" value="1994-03-12" />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">Blood Group</label>
                      <select name="p_bloodgroup" class="form-control">
                        <option value="">Select</option>
                        <option>A+</option>
                        <option>A-</option>
                        <option>B+</option>
                        <option>B-</option>
                        <option>AB+</option>
                        <option>AB-</option>
                        <option>O+</option>
                        <option>O-</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Gender</label>
                      <select name="p_gender" class="form-control">
                        <option value="">Select</option>
                        <option value="female">Female</option>
                        <option value="male">Male</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Address</label>
                    <textarea name="p_address" class="form-control" rows="3" placeholder="Street, city, state, ZIP">482 Maple Grove Lane, Health City, HC 90212</textarea>
                  </div>
                    <% } %>
                  <div class="form-actions">
                    <button type="reset" class="btn btn-outline">Reset</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                  </div>
                </form>
              </div>

              <div class="tab-panel" data-tab-panel="security" hidden>
                <div class="form-section-title">Change Password</div>
                <form action="#" method="post">
                  <div class="form-group">
                    <label class="form-label">Current Password <span class="required">*</span></label>
                    <div class="input-icon right">
                      <input type="password" name="oldPassword" id="oldPassword" class="form-control" required />
                      <i class="fa-regular fa-eye" data-toggle-password="oldPassword"></i>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">New Password <span class="required">*</span></label>
                      <input type="password" name="newPassword" class="form-control" minlength="6" required />
                    </div>
                    <div class="form-group">
                      <label class="form-label">Confirm New Password <span class="required">*</span></label>
                      <input type="password" name="confirmPassword" class="form-control" minlength="6" required />
                    </div>
                  </div>
                  <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Use at least 6 characters, mixing letters and numbers for a stronger password.</span>
                  </div>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-shield-halved"></i> Update Password</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

<%- include('footer.ejs'); %>
