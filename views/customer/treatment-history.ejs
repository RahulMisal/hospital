<%- include('header.ejs'); %>

      <div class="dashboard-content">

        <div class="page-toolbar">
          <h2>Treatment History</h2>
          <div class="page-toolbar-actions">
            <span class="badge badge-primary">4 records</span>
          </div>
        </div>

        <div class="filter-bar">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" placeholder="Search by disease, doctor, or treatment…" />
          </div>
        </div>

        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th>Disease</th>
                <th>Diagnosis</th>
                <th>Treatment</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Medicine</th>
                <th>Next Visit</th>
              </tr>
            </thead>
            <tbody>
              <% for(var i=0;i<data2.length;i++){ %>
              <tr>
                <td><strong><%=data2[i].treatment_disease%></strong></td>
                <td><%=data2[i].treatment_diagnosis%></td>
                <td><%=data2[i].treatment_notes%></td>
                <td><%=data2[i].doc_name%></td>
                <td><%=data2[i].treatment_nextvisit%></td>
                <td><%=data2[i].treatment_medicines%></td>
                <td><%=data2[i].treatment_nextvisit%></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </main>
  </div>

<%- include('footer.ejs'); %>

